# Gmail: create an App Password at https://myaccount.google.com/apppasswords (needs 2-Step Verification)
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=
# Gmail label name exactly as shown in Gmail (nested labels use "/")
GMAIL_LABEL=transactions
BACKFILL_MONTHS=6
SYNC_INTERVAL_MIN=15

# Optional local LLM fallback. Leave OLLAMA_URL empty to disable.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b

HOST=127.0.0.1
PORT=4100
DB_PATH=data/money.db
